# RoadGuard-AI Environment Variables
# Backend is deployed at https://roadguard-backend-ympg.onrender.com
EXPO_PUBLIC_BACKEND_URL=https://roadguard-backend-ympg.onrender.com

# OpenWeatherMap API Key — replace with your own from https://openweathermap.org/api
# Free tier is sufficient (60 calls/min)
EXPO_PUBLIC_OPENWEATHER_API_KEY=your_openweather_api_key_here
